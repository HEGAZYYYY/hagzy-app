PORT=4000
# Required in production (the server refuses to start without them).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: comma-separated web origins allowed by CORS (default: any)
CORS_ORIGINS=
# Optional: fixed login for App Store / Play review (leave empty to disable)
REVIEWER_TARGET=
REVIEWER_CODE=

# Live Cloud PostgreSQL Database (Render Postgres, Supabase, Neon)
DATABASE_URL=

# Real Google OAuth 2.0 (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Real Apple Sign-In (Apple Developer Account)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Real Email Dispatch (Resend or SMTP)
RESEND_API_KEY=
# Or SMTP (Gmail / SendGrid / Amazon SES):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Egyptian WhatsApp Notifications (UltraMsg or Meta Cloud API)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# SMS Gateway (Twilio / CEQUENS / VictoryLink)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Paymob Gateway
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=

